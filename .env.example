# Service Configuration
PROJECT_NAME="Nuveq Access Control Middle Service"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# Database (SQLite default for MVP, or Postgres: postgresql+asyncpg://user:pass@localhost:5432/dbname)
DATABASE_URL="sqlite+aiosqlite:///./nuveq_middle.db"

# Nuveq Cloud Configuration (Master key never exposed to client)
NUVEQ_BASE_URL="https://api-v2.nuveq.cloud"
NUVEQ_API_KEY="your_nuveq_master_api_key_here"
NUVEQ_WEBHOOK_SECRET="change_me_to_a_secure_random_token"

# Client Authentication (Comma-separated keys for client website/apps)
CLIENT_API_KEYS="client-dev-key-123,client-prod-key-456"

# Business Rules Defaults
DEFAULT_GRACE_MINUTES=15
DEFAULT_AUTO_CHECKOUT_BUFFER_MINUTES=15

# Background Scheduler
SCHEDULER_ENABLED=true
EXPIRY_CHECK_INTERVAL_SECONDS=60
RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL_SECONDS=300

# No-show auto-revocation. Keep true in production.
# Set false ONLY for local testing: bookings are never auto-expired and
# abandoned credentials remain valid at the reader.
NO_SHOW_EXPIRY_ENABLED=true

# Allow bookings with a visit_start already in the past. Keep false in production.
ALLOW_PAST_VISIT_START=false

# Production environment template for dev.app-cube.tech
#
# Copy to .env ON THE VPS ONLY and fill in real values. Never commit .env.
#   cp .env.production.example .env && chmod 600 .env
#
# Generate secrets with:  openssl rand -hex 32

# --- Service ---
PROJECT_NAME="Nuveq Access Control Middle Service"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"

# --- Database (Postgres service in docker-compose.prod.yml) ---
POSTGRES_DB="myboga"
POSTGRES_USER="myboga"
POSTGRES_PASSWORD=""                      # REQUIRED: openssl rand -hex 24
DATABASE_URL="postgresql+asyncpg://myboga:<same-as-POSTGRES_PASSWORD>@db:5432/myboga"

# --- Nuveq Cloud (master key stays server-side, never exposed to clients) ---
NUVEQ_BASE_URL="https://api-v2.nuveq.cloud"
NUVEQ_API_KEY=""                           # REQUIRED
NUVEQ_WEBHOOK_SECRET=""                    # REQUIRED: openssl rand -hex 32

# --- Client authentication ---
# Comma-separated. Use a strong random value, never a well-known dev key.
CLIENT_API_KEYS=""                         # REQUIRED: openssl rand -hex 24

# --- Business rules ---
DEFAULT_GRACE_MINUTES=15
DEFAULT_AUTO_CHECKOUT_BUFFER_MINUTES=15

# --- Scheduler ---
SCHEDULER_ENABLED=true
EXPIRY_CHECK_INTERVAL_SECONDS=60
RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL_SECONDS=300

# --- Safety flags: MUST stay production-safe on any public host ---
# NO_SHOW_EXPIRY_ENABLED=false would leave abandoned door credentials
# permanently valid at the reader. Only ever disable on localhost.
NO_SHOW_EXPIRY_ENABLED=true
ALLOW_PAST_VISIT_START=false
